# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Cyber Defense SOC Server-Side Telemetry & SOAR Proxy Configuration ---
# Organization display name & primary protected portal URL
ORG_NAME="My Organization"
TARGET_PORTAL_URL="https://example.org"
TARGET_SECONDARY_URL=""
TARGET_LOGIN_URL=""
TARGET_ROOT_DOMAIN=""

# Comma-separated brand/phishing monitoring keywords for OpenPhish matching
CTI_BRAND_KEYWORDS="login,verify,portal,sso"

# Wazuh / Elastic SIEM upstream stream & API credentials (server-side only)
SIEM_STREAM_URL=""
SIEM_API_KEY=""

# Bi-Directional WAF / SOAR Webhook (Cloudflare / Imperva / Cortex XSOAR)
WAF_WEBHOOK_URL=""
WAF_API_TOKEN=""
SOAR_WEBHOOK_URL=""

# OpenCTI & National CERT STIX2 / TAXII Feed Credentials
OPENCTI_GRAPHQL_URL=""
OPENCTI_API_TOKEN=""
GOV_CERT_TAXII_URL=""
GOV_CERT_API_KEY=""

# Optional shared secret for external SIEM/WAF webhook ingestion (POST /api/ingest/siem)
INGEST_SHARED_SECRET=""
